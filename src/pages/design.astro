---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Icon from '~/components/Icon.astro';
import { getProjects, getSiteSettings } from '~/lib/contentful';
import { WIREFRAME } from '~/lib/wireframe-content';
import { ROUTES } from '~/lib/site';

const [projects, settings] = await Promise.all([getProjects(), getSiteSettings()]);

/* Explicitly featured only: getFeaturedProjects() falls back to all finished work. */
const featured = projects.filter((project) => project.featured);
const showFeatured = featured.length >= WIREFRAME.featuredMinimum;
const description = settings.seo.description ?? 'Work, by Cole Anderson.';
---

<BaseLayout title="Design" path={ROUTES.design} description={description}>
  <a
    class="panel-close icon-control"
    href="/#design"
    data-return-to-cta
    aria-label="Back to design section"
    title="Back to design section"><Icon name="arrow-left" /></a
  >
  {
    showFeatured && (
      <section class="wire page wire--decided">
        <span class="wire-label">Featured work</span>
        <ul class="grid--wheel grid">
          {featured.map((project) => (
            <li>
              <a class="slot" href={ROUTES.work(project.slug)}>
                [slide] {project.title}
              </a>
            </li>
          ))}
        </ul>
        <a
          class="icon-control"
          href="#work-cloud"
          aria-label="See all design work"
          title="See all design work"
        >
          <Icon name="layout-grid" />
        </a>
      </section>
    )
  }

  <section class="wire page wire--decided" id="work-cloud">
    <span class="wire-label">Work cloud</span>
    <h1>Design</h1>
    <div class="slot slot--hero">[work cloud]</div>
    <ul class="grid--sets grid">
      {
        projects.map((project) => (
          <li>
            <a href={ROUTES.work(project.slug)}>{project.title}</a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
