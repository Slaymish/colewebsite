---
import BaseLayout from '~/layouts/BaseLayout.astro';
import HomeHero from '~/components/HomeHero.astro';
import { getSiteSettings } from '~/lib/contentful';
import { personJsonLd } from '~/lib/seo';
import { SITE } from '~/lib/site';

const settings = await getSiteSettings();
const jobTitle = settings.seo.jobTitle ?? SITE.jobTitle;
const description = settings.seo.description ?? SITE.description;
---

<BaseLayout
  title="I am human"
  path="/"
  description={description}
  jsonLd={personJsonLd(jobTitle, description, settings.seo.profiles)}
>
  <HomeHero />

  <a class="home-section home-word" id="design" href="/design"><span>DESIGN</span></a>

  <a class="home-section home-word" id="photography" href="/photography"
    ><span>PHOTOGRAPHY</span></a
  >

  <section class="page">
    <span class="wire-label">What makes me human</span>
    <div class="slot slot--hero">[about]</div>
  </section>

  <footer class="home-section" id="contact">
    <a class="home-word" href="/contact">CONTACT ME</a>
  </footer>
</BaseLayout>

<style>
  .home-section {
    display: grid;
    min-height: 100svh;
    place-items: center;
    margin: 0;
    padding: var(--lab-section-padding, 4vw);
    text-align: center;
  }
  .home-word {
    font-family: var(--display-font);
    font-weight: var(--lab-display-weight, 900);
    font-size: calc(clamp(1.5rem, 11vw, 16rem) * var(--lab-word-scale, 1));
    line-height: 1;
    letter-spacing: var(--lab-display-tracking, -0.045em);
  }
  .home-word:focus-visible {
    outline: 3px solid var(--lab-accent, #0f5c8c);
    outline-offset: 0.25em;
  }
  .home-section.home-word:focus-visible {
    outline: none;
  }
  .home-section.home-word:focus-visible > span {
    outline: 3px solid var(--lab-accent, #0f5c8c);
    outline-offset: 0.1em;
  }
</style>
