---
import BaseLayout from '~/layouts/BaseLayout.astro';
import HomeHero from '~/components/HomeHero.astro';
import { getSiteSettings } from '~/lib/contentful';
import { personJsonLd } from '~/lib/seo';
import { SITE } from '~/lib/site';

const settings = await getSiteSettings();
const jobTitle = settings.seo.jobTitle ?? SITE.jobTitle;
const description = settings.seo.description ?? SITE.description;
---

<BaseLayout
  title="I am human"
  path="/"
  description={description}
  jsonLd={personJsonLd(jobTitle, description, settings.seo.profiles)}
>
  <HomeHero />

  <a class="wire page" href="/design">
    <span class="wire-label">Design CTA</span>
    <span class="slot slot--hero">[design]</span>
  </a>

  <a class="wire page" href="/photography">
    <span class="wire-label">Photography CTA</span>
    <span class="slot slot--hero">[photography]</span>
  </a>

  <section class="wire page wire--decided">
    <span class="wire-label">What makes me human</span>
    <div class="slot slot--hero">[about]</div>
  </section>

  <footer class="page">
    <a class="shout" href="/contact">contact me</a>
  </footer>
</BaseLayout>
