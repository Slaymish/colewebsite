---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { getSiteSettings } from '~/lib/contentful';
import { personJsonLd } from '~/lib/seo';
import { SITE } from '~/lib/site';

const settings = await getSiteSettings();
const jobTitle = settings.seo.jobTitle ?? SITE.jobTitle;
const description = settings.seo.description ?? SITE.description;
---

<BaseLayout
  title="I am human"
  path="/"
  description={description}
  jsonLd={personJsonLd(jobTitle, description, settings.seo.profiles)}
>
  <section class="wire wire--decided">
    <span class="wire-label">Hero</span>
    <h1>I am human</h1>
    <div class="slot slot--hero">[animated illustration] [wordmark]</div>
  </section>

  <a class="wire slot slot--hero" href="/design">
    <span class="wire-label">Design CTA</span>
  </a>

  <a class="wire slot slot--hero" href="/photography">
    <span class="wire-label">Photography CTA</span>
  </a>

  <section class="wire wire--decided">
    <span class="wire-label">What makes me human</span>
    <div class="slot slot--hero">[about]</div>
  </section>

  <a class="wire slot" href="/contact">
    <span class="wire-label">Contact CTA</span>
  </a>

  <footer>
    <span class="wire-label">Footer</span>
    <p class="wide-footer"><a href="/contact">contact</a></p>
  </footer>
</BaseLayout>
