---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Band from '~/components/patterns/Band.astro';
import PageHeader from '~/components/patterns/PageHeader.astro';
import ContactBlock from '~/components/patterns/ContactBlock.astro';
import { getSiteSettings } from '~/lib/contentful';

const settings = await getSiteSettings();
---

<BaseLayout title="Contact" path="/contact">
  <Band pad="lg" class="pb-12 md:pb-16">
    <PageHeader
      title="Contact"
      standfirst="Collaborations, commissions, and anyone who wants to know how something was made."
    />
  </Band>

  <Band pad="none" class="pb-20 md:pb-32">
    <ContactBlock settings={settings} />
  </Band>
</BaseLayout>
