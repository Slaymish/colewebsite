---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { getSiteSettings } from '~/lib/contentful';
import { ROUTES } from '~/lib/site';

const settings = await getSiteSettings();
const email = settings.contact.email;
---

<BaseLayout title="Contact" path={ROUTES.contact} description="Contact Cole Anderson.">
  <section class="wire page wire--decided">
    <span class="wire-label">Email</span>
    <p class="shout">
      {email ? <a href={`mailto:${email}`}>{email}</a> : '[email]'}
    </p>
  </section>

  <section class="wire page">
    <span class="wire-label">Elsewhere</span>
    {
      settings.seo.profiles.length > 0 ? (
        <ul class="bare">
          {settings.seo.profiles.map((profile) => (
            <li>{profile}</li>
          ))}
        </ul>
      ) : (
        <p class="slot">[social links]</p>
      )
    }
  </section>
</BaseLayout>
