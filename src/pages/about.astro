---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Band from '~/components/patterns/Band.astro';
import PageHeader from '~/components/patterns/PageHeader.astro';
import Figure from '~/components/ui/Figure.astro';
import Label from '~/components/ui/Label.astro';
import Link from '~/components/ui/Link.astro';
import Prose from '~/components/ui/Prose.astro';
import { getAbout, getSiteSettings } from '~/lib/contentful';
import { personJsonLd } from '~/lib/seo';
import { SITE } from '~/lib/site';
import { editable } from '~/lib/preview';

const [about, settings] = await Promise.all([getAbout(), getSiteSettings()]);

const jobTitle = settings.seo.jobTitle ?? SITE.jobTitle;
const email = about.email ?? settings.contact.email;
---

<BaseLayout
  title="About"
  path="/about"
  jsonLd={personJsonLd(
    jobTitle,
    settings.seo.description ?? SITE.description,
    settings.seo.profiles,
  )}
>
  <Band pad="lg" class="pb-12 md:pb-16">
    <PageHeader title="About" eyebrow={jobTitle} />
  </Band>

  {
    /* The portrait leads and runs tall down the left, with the text set against
      it rather than beside a thumbnail. On a page whose whole job is that the
      person is visible, a 20rem headshot in the margin is the wrong weight. */
  }
  <Band pad="none" class="pb-20 md:pb-32">
    <div class="grid grid-cols-12 gap-x-6 gap-y-10">
      <div
        class="col-span-12 md:col-span-5 lg:col-span-4"
        {...editable('about', about.cmsId, 'portrait')}
      >
        <Figure
          image={about.portrait}
          ratio="portrait"
          crop
          sizes="(min-width: 1024px) 32vw, (min-width: 768px) 40vw, 100vw"
          label="Portrait"
        />
      </div>

      <div
        class="col-span-12 flex flex-col gap-10 md:col-span-6 md:col-start-7 lg:col-span-7"
      >
        <div {...editable('about', about.cmsId, 'body')}>
          <Prose paragraphs={about.body} leadFirst />
        </div>
        {
          email && (
            <div class="flex flex-col gap-2">
              <Label tone="accent">Email</Label>
              <Link href={`mailto:${email}`}>{email}</Link>
            </div>
          )
        }
      </div>
    </div>
  </Band>
</BaseLayout>
