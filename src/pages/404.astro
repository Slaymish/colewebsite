---
import BaseLayout from '~/layouts/BaseLayout.astro';

/** `/404` — kept real so a bad link is a page rather than an S3 error document. */
---

<BaseLayout title="Not found" path="/404" noindex>
  <h1 class="page-title">404</h1>
  <p class="wire-note">[not found — one line, in voice, plus the way back]</p>
  <p><a href="/">← home</a></p>
</BaseLayout>
