---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Band from '~/components/patterns/Band.astro';
import Heading from '~/components/ui/Heading.astro';
import Label from '~/components/ui/Label.astro';
import Link from '~/components/ui/Link.astro';
import Rule from '~/components/ui/Rule.astro';
import Text from '~/components/ui/Text.astro';
---

<BaseLayout title="Page not found" path="/404" noindex>
  <Band pad="lg">
    <div class="flex flex-col gap-8">
      <Rule tone="accent-warm" weight="thick" />
      <Label tone="accent-warm">Error 404</Label>
      <Heading level={1} size="mega">404</Heading>
      <Text size="lead" tone="muted" class="max-w-measure">
        That page has moved, or it never existed.
      </Text>
      <p class="mt-4">
        <Link href="/">Back to the work</Link>
      </p>
    </div>
  </Band>
</BaseLayout>
