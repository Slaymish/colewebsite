---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Band from '~/components/patterns/Band.astro';
import PageHeader from '~/components/patterns/PageHeader.astro';
import PlayGrid from '~/components/patterns/PlayGrid.astro';
import Text from '~/components/ui/Text.astro';
import { getPlay } from '~/lib/contentful';

/**
 * Play — unfinished things and experiments, kept off the work index on purpose.
 *
 * Deliberately not hidden when empty: the page still renders and says so, because
 * a 404 on a link in the nav is worse than an honest empty section.
 */
const play = await getPlay();
---

<BaseLayout title="Play" path="/play">
  <Band pad="lg" class="pb-12 md:pb-16">
    <PageHeader
      title="Play"
      eyebrow="Unfinished"
      eyebrowTone="accent-warm"
      standfirst="Experiments, offcuts, and things still in progress. Not finished work, and not ordered."
    />
  </Band>

  <Band pad="none" class="pb-16 md:pb-24">
    {
      play.length > 0 ? (
        <PlayGrid projects={play} />
      ) : (
        <Text tone="muted">[Nothing marked as play in Contentful yet.]</Text>
      )
    }
  </Band>
</BaseLayout>
