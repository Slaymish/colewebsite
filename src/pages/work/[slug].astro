---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { getProjects } from '~/lib/contentful';
import { creativeWorkJsonLd } from '~/lib/seo';
import { ROUTES } from '~/lib/site';
import type { Project } from '~/lib/content-types';

export const getStaticPaths = (async () => {
  const projects = await getProjects();

  return projects.map((project, index) => ({
    params: { slug: project.slug },
    props: {
      project,
      previous: index > 0 ? (projects[index - 1] ?? null) : null,
      next: index < projects.length - 1 ? (projects[index + 1] ?? null) : null,
    },
  }));
}) satisfies GetStaticPaths;

const { project, previous, next } = Astro.props as {
  project: Project;
  previous: Project | null;
  next: Project | null;
};

const path = ROUTES.work(project.slug);
const description = project.metaDescription ?? project.body[0] ?? '';
---

<BaseLayout
  title={project.title}
  description={description}
  path={path}
  jsonLd={creativeWorkJsonLd({ title: project.title, description, path })}
>
  <section class="wire page">
    <span class="wire-label">Title · materials</span>
    <h1>{project.title}</h1>
    <div class="slot slot--cover">[cover]</div>
    {
      project.tags.length > 0 && (
        <ul class="bare">
          {project.tags.map((tag) => (
            <li>{tag}</li>
          ))}
        </ul>
      )
    }
  </section>

  <section class="wire page">
    <span class="wire-label">Body</span>
    {project.body.map((paragraph) => <p>{paragraph}</p>)}
  </section>

  <section class="wire page">
    <span class="wire-label">Gallery</span>
    <ul class="grid--photos grid">
      {
        project.gallery.length > 0 ? (
          project.gallery.map((_image, i) => (
            <li class="slot">[{String(i + 1).padStart(2, '0')}]</li>
          ))
        ) : (
          <li class="slot">[gallery]</li>
        )
      }
    </ul>
  </section>

  <section class="wire page">
    <span class="wire-label">Process</span>
    <ul class="grid--photos grid">
      {
        project.process.length > 0 ? (
          project.process.map((_note, i) => (
            <li class="slot">[{String(i + 1).padStart(2, '0')}]</li>
          ))
        ) : (
          <li class="slot">[process]</li>
        )
      }
    </ul>
  </section>

  <nav class="wire page" aria-label="Previous and next">
    <span class="wire-label">Prev / next</span>
    <p>
      {previous ? <a href={ROUTES.work(previous.slug)}>← {previous.title}</a> : '[start]'}
      {' · '}
      {next ? <a href={ROUTES.work(next.slug)}>{next.title} →</a> : '[end]'}
    </p>
  </nav>
</BaseLayout>
