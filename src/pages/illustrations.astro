---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Icon from '~/components/Icon.astro';
import { HERO_ILLUSTRATIONS } from '~/lib/hero';
import { GALLERY_OFFSETS } from '~/lib/gallery-state';
---

<BaseLayout
  title="Illustrations"
  path="/illustrations"
  description="Explore the illustrations on Cole Anderson's homepage."
>
  <section
    class="illustrations"
    data-illustration-gallery
    style={{ '--illustration-count': HERO_ILLUSTRATIONS.length }}
  >
    <header class="illustrations__header">
      <a class="icon-control" href="/" aria-label="Back to home" title="Back to home"
        ><Icon name="arrow-left" /></a
      >
      <h1>Illustrations</h1>
      <button
        class="icon-control"
        type="button"
        data-gallery-view
        aria-label="View all illustrations"
        title="View all illustrations"
        hidden
      >
        <span data-gallery-grid-icon><Icon name="layout-grid" /></span>
        <span data-gallery-flight-icon><Icon name="orbit" /></span>
      </button>
    </header>
    <div class="illustrations__viewport">
      <div class="illustrations__space">
        {
          HERO_ILLUSTRATIONS.map(({ id, url }, index) => (
            <a
              class="illustrations__card"
              href={`/?illustration=${id}`}
              aria-label={`Open homepage with illustration ${index + 1}`}
              data-illustration-index={index}
              style={{
                '--card-index': index,
                '--card-x': `${GALLERY_OFFSETS[index % GALLERY_OFFSETS.length]?.[0] ?? 0}vw`,
                '--card-y': `${GALLERY_OFFSETS[index % GALLERY_OFFSETS.length]?.[1] ?? 0}vh`,
                '--card-rotation': `${index % 2 ? 7 : -6}deg`,
              }}
            >
              <span
                class="illustrations__drawing"
                style={{ '--illustration-url': `url("${url}")` }}
                aria-hidden="true"
              />
              <span class="illustrations__number" aria-hidden="true">
                {String(index + 1).padStart(2, '0')}
              </span>
            </a>
          ))
        }
      </div>
    </div>
    <div class="illustrations__instructions" data-gallery-instructions hidden>
      <span>Scroll to fly · Choose an illustration to return home</span>
      <button
        class="icon-control"
        type="button"
        data-gallery-next
        aria-label="Fly forward"
        title="Fly forward"><Icon name="arrow-down" /></button
      >
    </div>
  </section>
</BaseLayout>

<style>
  .illustrations {
    min-height: 100svh;
  }
  .illustrations__header {
    position: relative;
    z-index: 3;
    display: grid;
    grid-template-columns: 44px 1fr 44px;
    align-items: center;
    gap: 1rem;
    padding: 1.5rem;
    font:
      12px/1.5 Arial,
      sans-serif;
  }
  .illustrations__header h1 {
    margin: 0;
    font: inherit;
    justify-self: center;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }
  :global(html[data-gallery-view='flight']) [data-gallery-flight-icon],
  :global(html[data-gallery-view='grid']) [data-gallery-grid-icon] {
    display: none;
  }
  .illustrations__space {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
    gap: 3rem;
    padding: 4rem 5vw;
    pointer-events: none;
  }
  .illustrations__card {
    display: block;
    position: relative;
    aspect-ratio: 1;
    pointer-events: auto;
  }
  .illustrations__drawing {
    display: block;
    width: 100%;
    height: 100%;
    background: #0f5c8c;
    mask: var(--illustration-url) center / contain no-repeat;
  }
  .illustrations__number {
    position: absolute;
    bottom: 0;
    right: 0;
    font:
      10px/1.5 Arial,
      sans-serif;
    opacity: 0.6;
  }
  .illustrations__card:focus-visible {
    outline: 2px solid #0f5c8c;
    outline-offset: 6px;
  }
  .illustrations__card:hover .illustrations__drawing {
    background: #0d518c;
  }
  :global(html[data-gallery-view='flight']) .illustrations {
    height: calc(100svh + (var(--illustration-count) - 1) * 70svh);
  }
  :global(html[data-gallery-view='flight']) .illustrations__header {
    position: fixed;
    inset: 0 0 auto;
  }
  :global(html[data-gallery-view='flight']) .illustrations__viewport {
    position: sticky;
    top: 0;
    height: 100svh;
    overflow: hidden;
    perspective: 900px;
  }
  :global(html[data-gallery-view='flight']) .illustrations__space {
    display: block;
    position: absolute;
    inset: 0;
    padding: 0;
    transform-style: preserve-3d;
  }
  :global(html[data-gallery-view='flight']) .illustrations__card {
    position: absolute;
    top: 50%;
    left: 50%;
    width: clamp(12rem, 29vw, 30rem);
    height: clamp(12rem, 29vw, 30rem);
    will-change: transform;
    opacity: min(
      clamp(0.18, calc(1 + (var(--gallery-progress, 0) - var(--card-index)) * 0.1625), 1),
      clamp(0, calc(4 - (var(--gallery-progress, 0) - var(--card-index)) * 4.333333), 1)
    );
    transform: translate(-50%, -50%)
      translate3d(
        var(--card-x),
        var(--card-y),
        calc((var(--gallery-progress, 0) - var(--card-index)) * 650px)
      )
      rotate(var(--card-rotation));
  }
  .illustrations__instructions {
    position: fixed;
    z-index: 3;
    inset: auto 1.5rem 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    font:
      11px/1.5 Arial,
      sans-serif;
  }
  .illustrations__instructions[hidden] {
    display: none;
  }
  @media (max-width: 600px) {
    :global(html[data-gallery-view='flight']) .illustrations__card {
      width: 56vw;
      height: 56vw;
    }
    .illustrations__instructions span {
      max-width: 12rem;
    }
  }
</style>
