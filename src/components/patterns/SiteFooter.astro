---
import Container from '~/components/ui/Container.astro';
import Link from '~/components/ui/Link.astro';
import Text from '~/components/ui/Text.astro';
import { getSiteSettings } from '~/lib/contentful';
import { SITE } from '~/lib/site';

const settings = await getSiteSettings();
const year = new Date().getFullYear();
const copyright = settings.copyright ?? `© ${year} ${SITE.name}`;
---

<footer class="border-rule mt-28 border-t">
  <Container>
    <div class="flex flex-col gap-4 py-10 md:flex-row md:items-center md:justify-between">
      <Text size="sm" tone="muted">{copyright}</Text>
      <ul class="flex flex-wrap gap-6">
        {
          settings.contact.email && (
            <li>
              <Link href={`mailto:${settings.contact.email}`} class="text-sm">
                {settings.contact.email}
              </Link>
            </li>
          )
        }
        {
          settings.seo.profiles.map((profile) => (
            <li>
              <Link href={profile} class="text-sm">
                {new URL(profile).hostname.replace(/^www\./, '')}
              </Link>
            </li>
          ))
        }
      </ul>
    </div>
  </Container>
</footer>
