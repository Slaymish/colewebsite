---
import Heading from '~/components/ui/Heading.astro';
import Text from '~/components/ui/Text.astro';
import type { EditableProps } from '~/lib/preview';

/**
 * Title and optional standfirst. The two `editable` spreads are separate props
 * rather than one rest spread, because when both come from the CMS they are
 * different fields of the same entry and a single spread can only mark one.
 */
interface Props {
  title: string;
  eyebrow?: string | null;
  /**
   * The eyebrow carries two unrelated things — a job title on About, the play
   * marker on a project — so which of them the accent belongs to is the caller's
   * to say, not this component's.
   */
  eyebrowTone?: 'muted' | 'accent-warm';
  titleEditable?: EditableProps;
  eyebrowEditable?: EditableProps;
  size?: 'display' | 'xl';
}

const {
  title,
  eyebrow = null,
  eyebrowTone = 'muted',
  titleEditable = {},
  eyebrowEditable = {},
  size = 'xl',
} = Astro.props;
---

<div class="flex flex-col gap-3">
  {
    eyebrow && (
      <Text size="sm" tone={eyebrowTone} class="font-mono uppercase" {...eyebrowEditable}>
        {eyebrow}
      </Text>
    )
  }
  <Heading level={1} size={size} {...titleEditable}>{title}</Heading>
</div>
