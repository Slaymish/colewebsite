---
import { HERO_ARTWORK, HERO_PHRASES } from '~/lib/hero';
import HeroExperiments from '~/components/HeroExperiments.astro';
import Icon from '~/components/Icon.astro';

const initialPhrase = HERO_PHRASES[0];
const experimentsEnabled =
  import.meta.env.DEV || import.meta.env.PUBLIC_NOINDEX === 'true';
---

<section class="hero" id="hero" aria-label="Introduction" data-home-hero>
  <a
    class="hero__art-window"
    href="/illustrations"
    aria-label="Explore all illustrations"
  >
    <div class="hero__art-frame">
      <div class="hero__art" style={{ '--hero-art': `url("${HERO_ARTWORK[0]}")` }}>
        <div class="hero__ink"></div>
      </div>
    </div>
  </a>
  <h1 class="hero__title" aria-label={initialPhrase.label}>
    <span aria-hidden="true">I am</span>
    <span aria-hidden="true" data-hero-modifier>{initialPhrase.modifier}</span>
    <span aria-hidden="true">human</span>
  </h1>
  <button
    class="hero__pause icon-control"
    type="button"
    data-hero-pause
    aria-pressed="false"
    aria-label="Pause illustrations"
    title="Pause illustrations"
  >
    <span class="hero__pause-icon"><Icon name="pause" /></span>
    <span class="hero__play-icon"><Icon name="play" /></span>
  </button>
</section>
{experimentsEnabled && <HeroExperiments />}

<script>
  import { setupHero } from '~/lib/hero/experiment';
  document.addEventListener('astro:page-load', setupHero);
</script>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    container-type: inline-size;
    height: 100vh;
    height: 100svh;
    overflow: hidden;
    color: #262626;
  }
  .hero__art-window {
    position: absolute;
    inset: 0 0 0 67%;
    overflow: hidden;
    cursor: pointer;
  }
  .hero__art-frame {
    position: absolute;
    inset: 0;
  }
  .hero__art {
    position: absolute;
    inset: 5%;
    mask: var(--hero-art) center / contain no-repeat;
  }
  .hero__ink {
    position: absolute;
    inset: 0;
    background: #0f5c8c;
  }
  .hero__pause {
    position: absolute;
    left: 83.5%;
    bottom: 9%;
    transform: translateX(-50%);
  }
  .hero__play-icon,
  .hero__pause[aria-pressed='true'] .hero__pause-icon {
    display: none;
  }
  .hero__pause[aria-pressed='true'] .hero__play-icon {
    display: block;
  }
  .hero__art-window:focus-visible {
    outline: 2px solid #0f5c8c;
    outline-offset: -3px;
  }
  .hero__title {
    position: absolute;
    inset: 15.5% 36% 15.5% 3.5%;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: space-between;
    margin: 0;
    font-family: var(--display-font);
    font-size: min(8.3cqw, 20svh);
    font-weight: 900;
    line-height: 1;
    letter-spacing: -0.045em;
    text-align: left;
    text-transform: uppercase;
  }
  .hero__title span {
    display: block;
    white-space: nowrap;
  }
  @media (max-aspect-ratio: 1/1) {
    .hero__pause {
      left: 50%;
      bottom: 40%;
    }
    .hero__art-window {
      inset: 0 0 39%;
    }
    .hero__title {
      inset: 64% 4.5% 7%;
      font-size: min(11.5cqw, 8.5svh);
    }
  }
</style>
