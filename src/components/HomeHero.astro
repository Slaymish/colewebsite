---
import { HERO_ARTWORK, HERO_PHRASES } from '~/lib/hero';
import SiteLab from '~/components/SiteLab.astro';
import { LAB_ENABLED } from '~/lib/lab/controls';
import Icon from '~/components/Icon.astro';

const initialPhrase = HERO_PHRASES[0];
---

<section class="hero" id="hero" aria-label="Introduction" data-home-hero>
  <a
    class="hero__art-window"
    href="/illustrations"
    aria-label="Explore all illustrations"
  >
    <div class="hero__art-frame">
      <div class="hero__art" style={{ '--hero-art': `url("${HERO_ARTWORK[0]}")` }}>
        <div class="hero__ink"></div>
      </div>
    </div>
  </a>
  <h1 class="hero__title" aria-label={initialPhrase.label}>
    <span aria-hidden="true">I am</span>
    <span aria-hidden="true" data-hero-modifier>{initialPhrase.modifier}</span>
    <span aria-hidden="true">human</span>
  </h1>
  <button
    class="hero__pause icon-control"
    type="button"
    data-hero-pause
    aria-pressed="false"
    aria-label="Pause illustrations"
    title="Pause illustrations"
  >
    <span class="hero__pause-icon"><Icon name="pause" /></span>
    <span class="hero__play-icon"><Icon name="play" /></span>
  </button>
</section>
{LAB_ENABLED && <SiteLab />}

<script>
  import { setupHero } from '~/lib/hero/experiment';
  document.addEventListener('astro:page-load', setupHero);
</script>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    container-type: inline-size;
    height: 100vh;
    height: 100svh;
    overflow: hidden;
    color: var(--lab-ink, #262626);
  }
  .hero__art-window {
    position: absolute;
    inset: 0 0 0 calc(100% - var(--lab-hero-art-width, 33%));
    overflow: hidden;
    cursor: pointer;
  }
  .hero__art-frame {
    position: absolute;
    inset: 0;
  }
  .hero__art {
    position: absolute;
    inset: var(--lab-hero-art-padding, 5%);
    mask: var(--hero-art) center / contain no-repeat;
  }
  .hero__ink {
    position: absolute;
    inset: 0;
    background: var(--lab-illustration, #0f5c8c);
  }
  .hero__pause {
    position: absolute;
    left: calc(100% - var(--lab-hero-art-width, 33%) / 2);
    bottom: 9%;
    transform: translateX(-50%);
  }
  .hero__play-icon,
  .hero__pause[aria-pressed='true'] .hero__pause-icon {
    display: none;
  }
  .hero__pause[aria-pressed='true'] .hero__play-icon {
    display: block;
  }
  .hero__art-window:focus-visible {
    outline: 2px solid var(--lab-accent, #0f5c8c);
    outline-offset: -3px;
  }
  .hero__title {
    position: absolute;
    inset: var(--lab-hero-title-top, 15.5%) calc(var(--lab-hero-art-width, 33%) + 3%)
      var(--lab-hero-title-top, 15.5%) var(--lab-hero-title-left, 3.5%);
    display: var(--lab-hero-display, flex);
    flex-direction: column;
    align-items: flex-start;
    justify-content: space-between;
    margin: 0;
    font-family: var(--display-font);
    font-size: calc(min(8.3cqw, 20svh) * var(--lab-hero-scale, 1));
    font-weight: var(--lab-display-weight, 900);
    line-height: var(--lab-hero-line-height, 1);
    letter-spacing: var(--lab-display-tracking, -0.045em);
    text-align: left;
    text-transform: var(--lab-hero-transform, uppercase);
    hyphens: var(--lab-hero-hyphens, manual);
  }
  .hero__title span {
    display: var(--lab-hero-span-display, block);
    white-space: var(--lab-hero-white-space, nowrap);
    text-wrap: var(--lab-hero-text-wrap, wrap);
  }
  @media (max-aspect-ratio: 1/1) {
    .hero__pause {
      left: 50%;
      bottom: 40%;
    }
    .hero__art-window {
      inset: 0 0 39%;
    }
    .hero__title {
      inset: 64% 4.5% 7%;
      font-size: calc(min(11.5cqw, 8.5svh) * var(--lab-hero-scale, 1));
    }
  }
</style>
