---
import { isExternalHref, samePath } from '~/lib/ui';
import VisuallyHidden from './VisuallyHidden.astro';

/**
 * Every link on the site. It carries the two things easy to forget and silent
 * when forgotten: `rel="noopener noreferrer"` plus a spoken "(opens in a new
 * tab)" on external links, and `aria-current` when the href is the current page.
 */
interface Props {
  href: string;
  /**
   * For links that are their own affordance — the wordmark, the nav. Drops the
   * underline *and* the resting accent colour, leaving the accent on hover; see
   * the class list below for why those two travel together.
   */
  plain?: boolean;
  class?: string;
  [key: string]: unknown;
}

const { href, plain = false, class: className = '', ...rest } = Astro.props as Props;

const external = isExternalHref(href);
const current = !external && samePath(Astro.url.pathname, href);
---

<a
  href={href}
  aria-current={current ? 'page' : undefined}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener noreferrer' : undefined}
  class:list={[
    'duration-fast transition-colors',
    // A link that reads as body text keeps the accent for the hover alone —
    // colouring the wordmark and the nav would put the accent on most of the
    // header. Underlined links are the ones carrying it at rest.
    plain
      ? 'hover:text-accent'
      : 'decoration-skip-none text-accent hover:text-accent-deep underline underline-offset-4',
    className,
  ]}
  {...rest}
>
  <slot />
  {external && <VisuallyHidden>(opens in a new tab)</VisuallyHidden>}
</a>
