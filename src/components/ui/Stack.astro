---
/**
 * Vertical rhythm as a container decision rather than a margin on every child.
 * Literal class strings: Tailwind cannot see a class assembled at runtime.
 */
type Gap = 'xs' | 'sm' | 'md' | 'lg' | 'xl';

interface Props {
  gap?: Gap;
  as?: 'div' | 'section' | 'article' | 'ul' | 'ol' | 'li' | 'header' | 'footer';
  class?: string;
  [key: string]: unknown;
}

const {
  gap = 'md',
  as: Tag = 'div',
  class: className = '',
  ...rest
} = Astro.props as Props;

const GAP_CLASS: Record<Gap, string> = {
  xs: 'gap-2',
  sm: 'gap-4',
  md: 'gap-8',
  lg: 'gap-16',
  xl: 'gap-28',
};
---

<Tag class:list={['flex flex-col', GAP_CLASS[gap], className]} {...rest}>
  <slot />
</Tag>
