---
/**
 * The page shell, stripped.
 *
 * What is kept is the plumbing that is expensive to rebuild and has nothing to
 * do with how the site looks: the head, the SEO and JSON-LD builders in
 * `lib/seo.ts`, the canonical origin, the sitemap link, the noindex switch for
 * the test environment, and the one memoised site-settings fetch.
 *
 * What is gone is everything from the first design round: the palette layer in
 * `lib/theme.ts` (kept, but no longer rendered — a wireframe has no brand
 * colour), the font imports, the Tailwind utility layer, the header and footer
 * patterns, and the UI primitives. `src/styles/wireframe.css` still describes
 * unfinished content; `site.css` now adds the shared font, texture and panel motion.
 */
import '~/styles/wireframe.css';
import '~/styles/site.css';
import 'lenis/dist/lenis.css';
import { buildSeo, type SeoInput } from '~/lib/seo';
import { SITE } from '~/lib/site';
import { getSiteSettings } from '~/lib/contentful';
import { ClientRouter } from 'astro:transitions';
import { panelTransition } from '~/lib/navigation';
import { LAB_ENABLED } from '~/lib/lab/controls';

interface Props extends SeoInput {
  jsonLd?: Record<string, unknown>;
}

const { jsonLd, ...seoInput } = Astro.props;

/** Memoised, so this is one request per build rather than one per page. */
const settings = await getSiteSettings();

const seo = buildSeo(seoInput, {
  description: settings.seo.description,
  image: settings.seo.shareImage?.url,
});
---

<html
  lang="en-NZ"
  transition:name="root"
  transition:animate={panelTransition}
  data-lab={LAB_ENABLED ? '' : undefined}
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script src="/scripts/gallery-preference.js" is:inline></script>
    {LAB_ENABLED && <script src="/scripts/lab-preference.js" is:inline />}
    <ClientRouter />
    <title>{seo.title}</title>
    <meta name="description" content={seo.description} />
    <link rel="canonical" href={seo.canonical} />
    {seo.noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content={SITE.locale} />
    <meta property="og:title" content={seo.title} />
    <meta property="og:description" content={seo.description} />
    <meta property="og:url" content={seo.canonical} />
    {seo.image && <meta property="og:image" content={seo.image} />}
    <meta name="twitter:card" content={seo.image ? 'summary_large_image' : 'summary'} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    {
      jsonLd && (
        <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
      )
    }
  </head>
  <body>
    {
      /*
      No top nav. The site is four routes and it is entered through the two CTAs
      and the footer word, so there is deliberately no global navigation — see
      docs/design/wireframe.md.
    */
    }
    <main id="main">
      <slot />
    </main>
  </body>
</html>

<script>
  import { applyLab } from '~/lib/lab/state';
  import { setupPanelNavigation } from '~/lib/navigation';
  import { setupIllustrationGallery } from '~/lib/illustration-gallery';
  import { setupSmoothScroll } from '~/lib/scroll';
  setupPanelNavigation();
  document.addEventListener('astro:after-swap', setupIllustrationGallery);
  document.addEventListener('astro:page-load', setupIllustrationGallery);
  setupSmoothScroll();
  applyLab();
  document.addEventListener('astro:after-swap', () => applyLab());
</script>
