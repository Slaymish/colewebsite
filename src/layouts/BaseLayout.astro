---
/**
 * The page shell, stripped.
 *
 * What is kept is the plumbing that is expensive to rebuild and has nothing to
 * do with how the site looks: the head, the SEO and JSON-LD builders in
 * `lib/seo.ts`, the canonical origin, the sitemap link, the noindex switch for
 * the test environment, and the one memoised site-settings fetch.
 *
 * What is gone is everything from the first design round: the palette layer in
 * `lib/theme.ts` (kept, but no longer rendered — a wireframe has no brand
 * colour), the font imports, the Tailwind utility layer, the header and footer
 * patterns, and the UI primitives. `src/styles/wireframe.css` is the only
 * stylesheet left and it exists to draw boxes, not to propose a look.
 */
import '~/styles/wireframe.css';
import { buildSeo, type SeoInput } from '~/lib/seo';
import { SITE, NAV } from '~/lib/site';
import { getSiteSettings } from '~/lib/contentful';

interface Props extends SeoInput {
  jsonLd?: Record<string, unknown>;
}

const { jsonLd, ...seoInput } = Astro.props;

/** Memoised, so this is one request per build rather than one per page. */
const settings = await getSiteSettings();

const seo = buildSeo(seoInput, {
  description: settings.seo.description,
  image: settings.seo.shareImage?.url,
});
---

<html lang="en-NZ">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{seo.title}</title>
    <meta name="description" content={seo.description} />
    <link rel="canonical" href={seo.canonical} />
    {seo.noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content={SITE.locale} />
    <meta property="og:title" content={seo.title} />
    <meta property="og:description" content={seo.description} />
    <meta property="og:url" content={seo.canonical} />
    {seo.image && <meta property="og:image" content={seo.image} />}
    <meta name="twitter:card" content={seo.image ? 'summary_large_image' : 'summary'} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    {
      jsonLd && (
        <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
      )
    }
  </head>
  <body>
    {/* Wireframe chrome, not site chrome. It exists so the routes can be walked. */}
    <header class="chrome">
      <a href="/">[wordmark]</a>
      <nav aria-label="Primary">
        {NAV.map((item) => <a href={item.href}>{item.label}</a>)}
        <a href="/sitemap">Map</a>
      </nav>
    </header>

    <main id="main">
      <div class="wrap">
        <slot />
      </div>
    </main>

    <div class="cookie-bar">
      <span>[cookies]</span>
      <span>[dismiss]</span>
    </div>
  </body>
</html>
