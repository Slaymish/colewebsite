---
import '~/styles/global.css';

/*
 * The typefaces. Imported here as modules rather than `@import`ed into
 * tokens.css so that Vite resolves the package paths and fingerprints the
 * woff2 files — a bare specifier inside a stylesheet Tailwind is already
 * processing is not something either tool promises to resolve.
 *
 * `wdth.css` and not `index.css`: the standard file ships the weight axis
 * only, and the width axis is the entire reason Archivo is here. Every
 * masthead on the site would silently fall back to the drawn default width.
 */
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource-variable/jetbrains-mono/wght.css';
import { buildSeo, type SeoInput } from '~/lib/seo';
import { SITE } from '~/lib/site';
import SiteHeader from '~/components/patterns/SiteHeader.astro';
import SiteFooter from '~/components/patterns/SiteFooter.astro';
import SkipLink from '~/components/ui/SkipLink.astro';
import { getSiteSettings } from '~/lib/contentful';
import { themeStyle } from '~/lib/theme';

interface Props extends SeoInput {
  jsonLd?: Record<string, unknown>;
  /** The LCP image, preloaded so it is requested before the CSS resolves it. */
  preloadImage?: string;
}

const { jsonLd, preloadImage, ...seoInput } = Astro.props;

/**
 * The one fetch every page makes. `getSiteSettings` memoises, so this is a
 * single request per build rather than one per page.
 */
const settings = await getSiteSettings();

const seo = buildSeo(seoInput, {
  description: settings.seo.description,
  image: settings.seo.shareImage?.url,
});

/** Empty unless Cole has set a colour. See lib/theme.ts for what it overrides. */
const themeCss = themeStyle(settings.theme);
---

<html lang="en-NZ">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{seo.title}</title>
    <meta name="description" content={seo.description} />
    <link rel="canonical" href={seo.canonical} />
    {seo.noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content={SITE.locale} />
    <meta property="og:title" content={seo.title} />
    <meta property="og:description" content={seo.description} />
    <meta property="og:url" content={seo.canonical} />
    {seo.image && <meta property="og:image" content={seo.image} />}
    <meta name="twitter:card" content={seo.image ? 'summary_large_image' : 'summary'} />

    {
      preloadImage && (
        <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />
      )
    }

    {
      /* is:inline keeps this in the document rather than bundling it into a
        stylesheet, which is what puts the palette in the first response. */
    }
    {themeCss && <style is:inline set:html={themeCss} />}

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    {
      jsonLd && (
        <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
      )
    }
  </head>
  <body class="bg-page text-ink flex min-h-screen flex-col">
    <SkipLink />
    <SiteHeader />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
