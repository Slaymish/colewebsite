# Copy to .env for local development. Never commit the real values.

# Contentful — delivery token for published content, preview token for drafts.
# Cole owns the space; ask him for a delivery and a preview token.
CONTENTFUL_SPACE_ID=
CONTENTFUL_ENVIRONMENT=master
CONTENTFUL_DELIVERY_TOKEN=
CONTENTFUL_PREVIEW_TOKEN=
# 'true' on the test environment so drafts render; never true in production.
CONTENTFUL_USE_PREVIEW=false

# 'true' fails the build when any content is still placeholder. Production only.
REQUIRE_CMS_CONTENT=false

# Canonical origin for this build (drives canonical URLs, OG tags, sitemap).
# The deploy workflow sets it from the SITE_DOMAIN repository variable.
PUBLIC_SITE_URL=http://localhost:4321

# 'true' adds noindex to every page. The test environment sets it; production
# must never inherit it.
PUBLIC_NOINDEX=false

# Management token, only needed to run content-model migrations locally.
CONTENTFUL_MANAGEMENT_TOKEN=

# Fine-grained PAT on the site repo with Contents: read and write. Setup only —
# `pnpm cf:webhook` writes it into the Contentful webhook and nothing reads it
# again. Contentful stores it write-only, so keep your own copy.
GITHUB_DISPATCH_TOKEN=
