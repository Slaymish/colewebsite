{
  "$comment": "Project settings, committed to git. Personal overrides belong in .claude/settings.local.json, which is gitignored. Precedence, lowest to highest: ~/.claude/settings.json -> this file -> settings.local.json -> CLI flags -> managed policy.",

  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.development)",
      "Read(./.env.test)",
      "Read(./.env.production)",
      "Read(./**/*.pem)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh workflow run:*)",
      "Bash(pnpm cf:migrate:*)",
      "Bash(pnpm cf:webhook:*)",
      "Bash(pnpm cf:preview:*)",
      "Bash(aws:*)",
      "WebFetch"
    ],
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git show:*)",
      "Bash(rg:*)",
      "Bash(fd:*)",
      "Bash(ls:*)",
      "Bash(pnpm verify:*)",
      "Bash(pnpm build:*)",
      "Bash(pnpm check:*)",
      "Bash(pnpm lint:*)",
      "Bash(pnpm format:check:*)",
      "Bash(pnpm format:*)",
      "Bash(pnpm exec prettier:*)",
      "Bash(pnpm exec eslint:*)",
      "Bash(pnpm exec astro:*)",
      "Bash(pnpm exec cdk diff:*)",
      "Bash(pnpm exec cdk synth:*)"
    ]
  },

  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "PYTHONDONTWRITEBYTECODE=1 python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-brief.py\"",
            "timeout": 20
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "PYTHONDONTWRITEBYTECODE=1 python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-bash.py\"",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "PYTHONDONTWRITEBYTECODE=1 python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-paths.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "PYTHONDONTWRITEBYTECODE=1 python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/post-edit-check.py\"",
            "timeout": 90
          },
          {
            "type": "command",
            "command": "PYTHONDONTWRITEBYTECODE=1 python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-pairs.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "PYTHONDONTWRITEBYTECODE=1 python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/stop-gate.py\"",
            "timeout": 150
          }
        ]
      }
    ]
  }
}
